<%- include("partials/header") %>

<section class="page-hero">
    <div class="container">
        <span class="hero-label">CATEGORY MANAGEMENT</span>
        <h1><%= heading %></h1>
        <p>
            Add or update a community service category.
            Keep the category name clear and meaningful.
        </p>
    </div>
</section>

<section class="category-form-section">
    <div class="container">
        <div class="category-form-card">

            <div class="section-heading">
                <span class="section-label">CATEGORY DETAILS</span>
                <h2>Category Information</h2>
                <p>Enter the category name below.</p>
            </div>

            <% if (errors && errors.length > 0) { %>
                <div class="form-error-summary" role="alert" aria-live="assertive">
                    <h3>Please correct the following:</h3>
                    <ul>
                        <% errors.forEach((error) => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form action="<%= formAction %>" method="POST" class="category-form">

                <div class="form-group">
                    <label for="name">Category Name</label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= category.name %>"
                        maxlength="100"
                        required
                        autocomplete="off"
                        aria-describedby="name-help"
                    >

                    <small id="name-help">
                        Required. Enter between 3 and 100 characters.
                    </small>
                </div>

                <div class="form-actions">
                    <button type="submit" class="form-submit-button">
                        <%= buttonText %>
                    </button>

                    <a href="/categories" class="form-cancel-button">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
