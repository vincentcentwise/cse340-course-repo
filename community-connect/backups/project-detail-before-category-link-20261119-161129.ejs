<%- include("partials/header", { title }) %>

<section class="page-hero">
    <div class="container">
        <p class="section-label">Service Project</p>
        <h1><%= project.name %></h1>
        <p><%= project.description %></p>
    </div>
</section>

<section class="section">
    <div class="container">

        <% if (project.image) { %>
            <img
                src="<%= project.image %>"
                alt="<%= project.imageAlt || project.name %>"
                class="project-image"
            >
        <% } %>

        <div class="project-content">
            <h2>About This Project</h2>
            <p><%= project.description %></p>

            <p class="project-details">
                <strong>Organization:</strong>
                <a href="/organization/<%= project.organizationId %>">
                    <%= project.organizationName %>
                </a>
            </p>

            <p class="project-details">
                <strong>Project Date:</strong>
                <% if (project.projectDate) { %>
                    <%= new Date(project.projectDate + "T00:00:00").toLocaleDateString("en-GB", {
                        day: "numeric",
                        month: "long",
                        year: "numeric"
                    }) %>
                <% } else { %>
                    Date to be announced
                <% } %>
            </p>

            <p class="project-details">
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <p class="project-details">
                <strong>Activity:</strong>
                <%= project.activity %>
            </p>

            <div class="project-categories">
                <h3>Project Categories</h3>

                <% if (categories.length > 0) { %>
                    <div class="category-tags">
                        <% categories.forEach(category => { %>
                            <a
                                href="/category/<%= category.id %>"
                                class="category-tag"
                            >
                                <%= category.icon || "" %>
                                <%= category.name %>
                            </a>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p>No categories have been assigned to this project.</p>
                <% } %>
            </div>
        </div>

        <div class="project-actions">
            <a href="/edit-project/<%= project.id %>" class="card-link">
                Edit Project
            </a>

            <a href="/projects" class="card-link">
                Back to Service Projects
            </a>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
