<%- include("partials/header", { title }) %>

<section class="page-hero">
    <div class="container">
        <p class="section-label">Explore Category</p>
        <h1><%= category.icon || "" %> <%= category.name %></h1>
        <p><%= category.description %></p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <h2>Service Projects</h2>
            <p>Discover projects connected to this category.</p>
        </div>

        <% if (projects.length > 0) { %>
            <div class="project-grid">
                <% projects.forEach(project => { %>
                    <article class="project-card">
                        <% if (project.image) { %>
                            <img
                                src="<%= project.image %>"
                                alt="<%= project.imageAlt || project.name %>"
                                class="project-image"
                            >
                        <% } %>

                        <div class="project-content">
                            <h3>
                                <a href="/project/<%= project.id %>">
                                    <%= project.name %>
                                </a>
                            </h3>

                            <p><%= project.description %></p>

                            <p class="project-details">
                                <strong>Organization:</strong>
                                <%= project.organizationName %>
                            </p>

                            <p class="project-details">
                                <strong>Location:</strong>
                                <%= project.location %>
                            </p>

                            <a
                                href="/project/<%= project.id %>"
                                class="card-link"
                            >
                                View Project
                            </a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <p>No service projects are currently available in this category.</p>
        <% } %>

        <a href="/categories" class="card-link">Back to Categories</a>
    </div>
</section>

<%- include("partials/footer") %>
