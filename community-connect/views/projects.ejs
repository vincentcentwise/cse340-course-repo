<%- include("partials/header") %>

<section class="page-hero">
    <div class="container">
        <span class="hero-label">MAKE AN IMPACT</span>

        <h1>Discover Meaningful Service Projects</h1>

        <p>
            Find opportunities to volunteer, share your skills,
            support local initiatives, and make a difference.
        </p>
    </div>
</section>

<section class="projects-section">
    <div class="container">

        <div class="section-heading">
            <span class="section-label">VOLUNTEER OPPORTUNITIES</span>
            <h2>Find a Project That Inspires You</h2>

            <p>
                Every act of service matters.
                Explore our featured community projects.
            </p>
        </div>

        <div class="project-grid">

            <% projects.forEach((project) => { %>

                <article class="project-card">

                    <% if (project.image) { %>
                        <img
                            src="<%= project.image %>"
                            alt="<%= project.imageAlt || project.name %>"
                            class="project-image"
                        >
                    <% } %>

                    <div class="project-content">

                        <span class="project-category">
                            <%= project.category %>
                        </span>

                        <h3>
                            <a href="/project/<%= project.id %>">
                                <%= project.name %>
                            </a>
                        </h3>

                        <p><%= project.description %></p>

                        <div class="project-details">
                            <p>
                                <strong>Organization:</strong>
                                <a href="/organization/<%= project.organizationId %>">
                                    <%= project.organizationName %>
                                </a>
                            </p>

                            <p>
                                <strong>Project Date:</strong>
                                <% if (project.projectDate) { %>
                                    <%= new Date(project.projectDate + "T00:00:00").toLocaleDateString("en-GB", {
                                        day: "numeric",
                                        month: "long",
                                        year: "numeric"
                                    }) %>
                                <% } else { %>
                                    Date to be announced
                                <% } %>
                            </p>

                            <p>
                                <strong>Location:</strong>
                                <%= project.location %>
                            </p>

                            <p>
                                <strong>Activity:</strong>
                                <%= project.activity %>
                            </p>
                        </div>

                        <a
                            href="/project/<%= project.id %>"
                            class="card-link"
                        >
                            View Project &rarr;
                        </a>

                    </div>

                </article>

            <% }) %>

        </div>

    </div>
</section>

<%- include("partials/footer") %>
